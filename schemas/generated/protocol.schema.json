{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RawProtocol",
  "description": "A protocol document, as parsed.",
  "type": "object",
  "allOf": [
    {
      "description": "`approval_floor` and `approval_required` are one field; give one or the other, not both.",
      "not": {
        "required": [
          "approval_floor",
          "approval_required"
        ]
      }
    },
    {
      "description": "`default_failure_policy` and `on_failure` are one field; give one or the other, not both.",
      "not": {
        "required": [
          "default_failure_policy",
          "on_failure"
        ]
      }
    }
  ],
  "required": [
    "id",
    "title"
  ],
  "properties": {
    "approval_floor": {
      "description": "Capabilities no profile may grant outright.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Capability"
      },
      "uniqueItems": true
    },
    "approval_required": {
      "description": "An accepted spelling of `approval_floor`; give one or the other, not both.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Capability"
      },
      "uniqueItems": true
    },
    "artifact_kinds": {
      "description": "Artifact kinds this protocol reasons about.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/ArtifactKind"
      },
      "uniqueItems": true
    },
    "capabilities": {
      "description": "Capabilities a profile may mention.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Capability"
      },
      "uniqueItems": true
    },
    "default_failure_policy": {
      "description": "What happens on failure when nothing more specific says.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/FailurePolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_kinds": {
      "description": "Evidence kinds a requirement may mention.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/EvidenceKind"
      },
      "uniqueItems": true
    },
    "extends": {
      "description": "The protocol this one builds on.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/ProtocolRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "description": "Its identifier.",
      "allOf": [
        {
          "$ref": "#/definitions/ProtocolId"
        }
      ]
    },
    "observables": {
      "description": "Fact families a predicate may read.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/FactPattern"
      }
    },
    "on_failure": {
      "description": "An accepted spelling of `default_failure_policy`; give one or the other, not both.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/FailurePolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "phases": {
      "description": "Phases workflows are expected to declare.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/PhaseId"
      },
      "uniqueItems": true
    },
    "scales": {
      "description": "Ordered scales for non-numeric comparison.",
      "default": {},
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "summary": {
      "description": "What it covers.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "description": "A short human title.",
      "type": "string"
    },
    "verifiers": {
      "description": "Verifiers available to establish evidence.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Verifier"
      },
      "uniqueItems": true
    },
    "version": {
      "description": "Its major version.",
      "default": 1,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ArtifactKind": {
      "description": "Artifact kind in kebab-case; the named vocabulary is listed in `examples`, and any other kebab-case name is accepted as an organisation-specific kind.",
      "examples": [
        "vision",
        "product-requirements",
        "initiative",
        "epic",
        "story",
        "task",
        "specification",
        "acceptance-criteria",
        "design",
        "feature-design",
        "component-design",
        "architecture-design",
        "api-design",
        "data-design",
        "architecture-decision-record",
        "test-plan",
        "evaluation-plan",
        "verification-report",
        "review-result",
        "approval-record",
        "release-plan",
        "migration-plan",
        "runbook",
        "incident-report",
        "postmortem",
        "executable-system-specification"
      ],
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "Capability": {
      "description": "A semantic capability, such as `repository.write` or `deployment.create:staging`.",
      "examples": [
        "repository.read",
        "repository.write",
        "tests.execute",
        "command.execute",
        "network.read",
        "network.write",
        "telemetry.read",
        "production.read",
        "production.write",
        "secret.read",
        "artifact.read",
        "artifact.write",
        "planning.read",
        "planning.write",
        "review.request",
        "approval.request",
        "deployment.create:staging",
        "deployment.rollback:production"
      ],
      "type": "string"
    },
    "EvidenceKind": {
      "description": "A kind of evidence. The canonical names come first; the rest are older spellings still accepted.",
      "type": "string",
      "enum": [
        "test_result",
        "static_analysis",
        "contract_result",
        "property_test_result",
        "deployment_result",
        "metric_observation",
        "health_observation",
        "approval",
        "diff",
        "artifact",
        "review",
        "verification",
        "specification",
        "ess_conformance",
        "test_execution",
        "source_diff",
        "artifact_evidence",
        "review_result",
        "verification_record",
        "specification_record",
        "ess_conformance_result"
      ]
    },
    "FactPattern": {
      "description": "Pattern over fact paths; `*` matches one segment, a trailing `**` matches the rest.",
      "type": "string",
      "pattern": "^([A-Za-z0-9_*-]+)(\\.[A-Za-z0-9_*-]+)*$"
    },
    "FailurePolicy": {
      "description": "What to do when a requirement is not met: `block`, `abort`, or a mapping with `action: retry|rollback|escalate` and that action's parameters.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Node"
          }
        }
      ]
    },
    "Node": {
      "description": "Any JSON/YAML value: null, boolean, number, string, array or object."
    },
    "PhaseId": {
      "description": "phase identifier.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "ProtocolId": {
      "description": "protocol identifier.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "ProtocolRef": {
      "description": "Reference to a protocol at a major version, such as `aep/1`.",
      "type": "string",
      "pattern": "^(protocol:)?[a-z][a-z0-9-]*/[1-9][0-9]*$"
    },
    "Verifier": {
      "description": "A verifier class; the named classes are listed in `examples`, and any other name is treated as an external tool.",
      "examples": [
        "compiler",
        "test-runner",
        "contract-runner",
        "static-analyzer",
        "property-tester",
        "model-checker",
        "telemetry-query",
        "policy-engine",
        "human-approval",
        "human-review",
        "artifact-validator",
        "conformance-runner"
      ],
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*([./][a-z0-9-]+)*$"
    }
  }
}
