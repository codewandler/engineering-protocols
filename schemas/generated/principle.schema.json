{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RawPrinciple",
  "description": "A principle document, as parsed.",
  "type": "object",
  "allOf": [
    {
      "description": "`applies_when` and `applicability` are one field; give one or the other, not both.",
      "not": {
        "required": [
          "applicability",
          "applies_when"
        ]
      }
    },
    {
      "description": "`on_failure` and `failure_policy` are one field; give one or the other, not both.",
      "not": {
        "required": [
          "failure_policy",
          "on_failure"
        ]
      }
    }
  ],
  "required": [
    "id",
    "title"
  ],
  "properties": {
    "applicability": {
      "description": "An accepted spelling of `applies_when`; give one or the other, not both.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/Predicate"
        },
        {
          "type": "null"
        }
      ]
    },
    "applies_when": {
      "description": "When it applies; omitted means always.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/Predicate"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "description": "What it takes away or puts behind approval.",
      "default": {},
      "allOf": [
        {
          "$ref": "#/definitions/CapabilityPolicy"
        }
      ]
    },
    "evidence": {
      "description": "Evidence that must exist by completion.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/EvidenceRequirement"
      }
    },
    "failure_policy": {
      "description": "An accepted spelling of `on_failure`; give one or the other, not both.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/FailurePolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "description": "Its identifier.",
      "allOf": [
        {
          "$ref": "#/definitions/PrincipleId"
        }
      ]
    },
    "obligations": {
      "description": "Explicitly identified obligations.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/RawObligation"
      }
    },
    "on_failure": {
      "description": "What happens when one of its requirements is not met.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/FailurePolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "requires": {
      "description": "Timed requirements, keyed by `always`, `before_<phase>`, `during_<phase>`, or given as requirement keys alongside a `before`/`during` selector.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/Node"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "description": "What it is for.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "description": "A short human title.",
      "type": "string"
    },
    "verification": {
      "description": "Verifiers that must have spoken.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Node"
      }
    },
    "version": {
      "description": "Its major version.",
      "default": 1,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ApprovalId": {
      "description": "approval identifier.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "ApprovalRequirement": {
      "description": "An approval that must have been granted: an approval identifier on its own, or a mapping naming the `approval` (or `id`) and whether a person must have granted it.",
      "oneOf": [
        {
          "$ref": "#/definitions/ApprovalId"
        },
        {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "approval"
              ]
            },
            {
              "required": [
                "id"
              ]
            }
          ],
          "properties": {
            "approval": {
              "$ref": "#/definitions/ApprovalId"
            },
            "human": {
              "type": "boolean"
            },
            "id": {
              "$ref": "#/definitions/ApprovalId"
            }
          }
        }
      ]
    },
    "ArtifactKind": {
      "description": "Artifact kind in kebab-case; the named vocabulary is listed in `examples`, and any other kebab-case name is accepted as an organisation-specific kind.",
      "examples": [
        "vision",
        "product-requirements",
        "initiative",
        "epic",
        "story",
        "task",
        "specification",
        "acceptance-criteria",
        "design",
        "feature-design",
        "component-design",
        "architecture-design",
        "api-design",
        "data-design",
        "architecture-decision-record",
        "test-plan",
        "evaluation-plan",
        "verification-report",
        "review-result",
        "approval-record",
        "release-plan",
        "migration-plan",
        "runbook",
        "incident-report",
        "postmortem",
        "executable-system-specification"
      ],
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "ArtifactRef": {
      "description": "Reference to an artifact, optionally pinned with `@<version>`.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*:[A-Za-z0-9][A-Za-z0-9._/-]*(@[^@]+)?$"
    },
    "ArtifactRequirement": {
      "description": "An artifact that must exist: an artifact kind on its own, or a mapping naming the `kind` and adding `status`, `at_least` (1 by default), `relation` and `fresh` (true by default).",
      "oneOf": [
        {
          "$ref": "#/definitions/ArtifactKind"
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "at_least": {
              "type": "integer",
              "minimum": 0.0
            },
            "fresh": {
              "type": "boolean"
            },
            "kind": {
              "$ref": "#/definitions/ArtifactKind"
            },
            "relation": {
              "$ref": "#/definitions/RelationRequirement"
            },
            "status": {
              "description": "The status the artifact must have reached.",
              "type": "string",
              "enum": [
                "draft",
                "proposed",
                "in_review",
                "in-review",
                "approved",
                "accepted",
                "rejected",
                "active",
                "implemented",
                "superseded",
                "archived"
              ]
            }
          }
        }
      ]
    },
    "Capability": {
      "description": "A semantic capability, such as `repository.write` or `deployment.create:staging`.",
      "examples": [
        "repository.read",
        "repository.write",
        "tests.execute",
        "command.execute",
        "network.read",
        "network.write",
        "telemetry.read",
        "production.read",
        "production.write",
        "secret.read",
        "artifact.read",
        "artifact.write",
        "planning.read",
        "planning.write",
        "review.request",
        "approval.request",
        "deployment.create:staging",
        "deployment.rollback:production"
      ],
      "type": "string"
    },
    "CapabilityPolicy": {
      "description": "The capabilities an execution may exercise.",
      "type": "object",
      "not": {
        "required": [
          "approval_required",
          "require_approval"
        ]
      },
      "properties": {
        "allow": {
          "description": "Capabilities that may be exercised.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Capability"
          },
          "uniqueItems": true
        },
        "approval_required": {
          "description": "Capabilities that may be exercised only with a recorded approval.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Capability"
          },
          "uniqueItems": true
        },
        "deny": {
          "description": "Capabilities that must never be exercised.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Capability"
          },
          "uniqueItems": true
        },
        "require_approval": {
          "description": "An accepted spelling of `approval_required`; give one or the other, not both.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Capability"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "ConditionalRequirement": {
      "description": "Requirements that apply only when a condition holds: `when` says under what, `require` (or `requires`) says what is then owed.",
      "type": "object",
      "anyOf": [
        {
          "required": [
            "require"
          ]
        },
        {
          "required": [
            "requires"
          ]
        }
      ],
      "required": [
        "when"
      ],
      "properties": {
        "require": {
          "$ref": "#/definitions/RequirementSet"
        },
        "requires": {
          "$ref": "#/definitions/RequirementSet"
        },
        "when": {
          "$ref": "#/definitions/Predicate"
        }
      }
    },
    "EvidenceKind": {
      "description": "A kind of evidence. The canonical names come first; the rest are older spellings still accepted.",
      "type": "string",
      "enum": [
        "test_result",
        "static_analysis",
        "contract_result",
        "property_test_result",
        "deployment_result",
        "metric_observation",
        "health_observation",
        "approval",
        "diff",
        "artifact",
        "review",
        "verification",
        "specification",
        "ess_conformance",
        "trace_conformance",
        "test_execution",
        "source_diff",
        "artifact_evidence",
        "review_result",
        "verification_record",
        "specification_record",
        "ess_conformance_result"
      ]
    },
    "EvidenceRequirement": {
      "description": "Evidence that must have been produced: an evidence kind on its own, or a mapping naming the `kind` and adding `at_least` (1 by default), `subject`, `verifier`, `independent` (false by default) and `horizon` (never, by default) — the age past which an observation stops counting and the requirement reads unknown.",
      "oneOf": [
        {
          "$ref": "#/definitions/EvidenceKind"
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "at_least": {
              "type": "integer",
              "minimum": 0.0
            },
            "horizon": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "independent": {
              "type": "boolean"
            },
            "kind": {
              "$ref": "#/definitions/EvidenceKind"
            },
            "subject": {
              "$ref": "#/definitions/SubjectRef"
            },
            "verifier": {
              "$ref": "#/definitions/Verifier"
            }
          }
        }
      ]
    },
    "FailurePolicy": {
      "description": "What to do when a requirement is not met: `block`, `abort`, or a mapping with `action: retry|rollback|escalate` carrying that action's parameters and no others.",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "block",
            "abort",
            "retry",
            "rollback",
            "escalate"
          ]
        },
        {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "block"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "abort"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "retry"
              ]
            },
            "max_attempts": {
              "description": "How many attempts in total; at least one.",
              "type": "integer",
              "minimum": 1.0
            },
            "then": {
              "$ref": "#/definitions/FailurePolicy"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "rollback"
              ]
            },
            "require": {
              "$ref": "#/definitions/Predicate"
            },
            "rollback": {
              "description": "The nested spelling of the rollback precondition: `rollback: {require: …}`.",
              "type": "object",
              "properties": {
                "require": {
                  "$ref": "#/definitions/Predicate"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "escalate"
              ]
            },
            "to": {
              "description": "Who the failure is handed to.",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Node": {
      "description": "Any JSON/YAML value: null, boolean, number, string, array or object."
    },
    "Predicate": {
      "description": "A condition over facts: the compact expression form (`tests.unit.failed == 0`), a list (implicit `all`), or a mapping using `all`, `any`, `not`, `none` or a fact path with an operator constraint.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Node"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Node"
          }
        }
      ]
    },
    "PrincipleId": {
      "description": "principle identifier.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "RawObligation": {
      "description": "An explicitly identified obligation, as parsed.",
      "type": "object",
      "allOf": [
        {
          "description": "`requires` and `require` are one field; give one or the other, not both.",
          "not": {
            "required": [
              "require",
              "requires"
            ]
          }
        }
      ],
      "required": [
        "id"
      ],
      "properties": {
        "always": {
          "description": "Checked at every transition.",
          "default": false,
          "type": "boolean"
        },
        "before": {
          "description": "Before entering this phase or state.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/Node"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "description": "What it is for.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "during": {
          "description": "While in this phase or state.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/Node"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "description": "Its identifier within the principle.",
          "type": "string"
        },
        "require": {
          "description": "An accepted spelling of `requires`; give one or the other, not both.",
          "default": {},
          "allOf": [
            {
              "$ref": "#/definitions/RequirementSet"
            }
          ]
        },
        "requires": {
          "description": "What must hold.",
          "default": {},
          "allOf": [
            {
              "$ref": "#/definitions/RequirementSet"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "RelationKind": {
      "description": "The meaning of an edge in the artifact graph.",
      "oneOf": [
        {
          "description": "Shaped by, without being derived from.",
          "type": "string",
          "enum": [
            "informed_by"
          ]
        },
        {
          "description": "Produced from a higher-level artifact.",
          "type": "string",
          "enum": [
            "derived_from"
          ]
        },
        {
          "description": "Breaks a larger artifact into smaller work.",
          "type": "string",
          "enum": [
            "decomposes"
          ]
        },
        {
          "description": "States the required behaviour of something.",
          "type": "string",
          "enum": [
            "specifies"
          ]
        },
        {
          "description": "Proposes how to satisfy something.",
          "type": "string",
          "enum": [
            "designs"
          ]
        },
        {
          "description": "Realises something in the system.",
          "type": "string",
          "enum": [
            "implements"
          ]
        },
        {
          "description": "Records a decision taken within something.",
          "type": "string",
          "enum": [
            "decides"
          ]
        },
        {
          "description": "Assesses something.",
          "type": "string",
          "enum": [
            "reviews"
          ]
        },
        {
          "description": "Establishes that something holds.",
          "type": "string",
          "enum": [
            "verifies"
          ]
        },
        {
          "description": "Prevents progress on something.",
          "type": "string",
          "enum": [
            "blocks"
          ]
        },
        {
          "description": "Needs something else first.",
          "type": "string",
          "enum": [
            "depends_on"
          ]
        },
        {
          "description": "Replaces something.",
          "type": "string",
          "enum": [
            "supersedes"
          ]
        },
        {
          "description": "Produces the outcome something asked for.",
          "type": "string",
          "enum": [
            "delivers"
          ]
        }
      ]
    },
    "RelationRequirement": {
      "description": "A relationship the artifact must have: a relation name on its own, or a mapping naming the `kind` and the `target_kind` it must point at.",
      "oneOf": [
        {
          "$ref": "#/definitions/RelationKind"
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "$ref": "#/definitions/RelationKind"
            },
            "target_kind": {
              "$ref": "#/definitions/ArtifactKind"
            }
          }
        }
      ]
    },
    "RequirementSet": {
      "description": "What must hold: a predicate, a list of predicates, or a mapping using `predicates`, `evidence`, `artifacts`, `reviews`, `approvals` and `conditional`. Any other key in the mapping is read as a fact predicate, so `{change.architectural: true}` works wherever a requirement set is expected.",
      "anyOf": [
        {
          "$ref": "#/definitions/Predicate"
        },
        {
          "type": "object",
          "properties": {
            "approval": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ApprovalRequirement"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ApprovalRequirement"
                  }
                }
              ]
            },
            "approvals": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ApprovalRequirement"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ApprovalRequirement"
                  }
                }
              ]
            },
            "artifact": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ArtifactRequirement"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ArtifactRequirement"
                  }
                }
              ]
            },
            "artifacts": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ArtifactRequirement"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ArtifactRequirement"
                  }
                }
              ]
            },
            "conditional": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ConditionalRequirement"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ConditionalRequirement"
                  }
                }
              ]
            },
            "conditional_requirements": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ConditionalRequirement"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ConditionalRequirement"
                  }
                }
              ]
            },
            "evidence": {
              "anyOf": [
                {
                  "$ref": "#/definitions/EvidenceRequirement"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/EvidenceRequirement"
                  }
                }
              ]
            },
            "predicates": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Predicate"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Predicate"
                  }
                }
              ]
            },
            "review": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ReviewRequirement"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ReviewRequirement"
                  }
                }
              ]
            },
            "reviews": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ReviewRequirement"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ReviewRequirement"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "ReviewDisposition": {
      "description": "What a review concluded.",
      "oneOf": [
        {
          "description": "Accepted as it stands.",
          "type": "string",
          "enum": [
            "approved"
          ]
        },
        {
          "description": "Not accepted yet; specific changes are wanted.",
          "type": "string",
          "enum": [
            "changes_requested"
          ]
        },
        {
          "description": "Not accepted.",
          "type": "string",
          "enum": [
            "rejected"
          ]
        }
      ]
    },
    "ReviewRequirement": {
      "description": "A review that must have happened: an artifact kind on its own, meaning an approving review of one, or a mapping naming `subject_kind` (or `kind`) or a specific `subject`, and adding `result` (approved by default), `human` and `fresh`.",
      "oneOf": [
        {
          "$ref": "#/definitions/ArtifactKind"
        },
        {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "subject_kind"
              ]
            },
            {
              "required": [
                "kind"
              ]
            },
            {
              "required": [
                "subject"
              ]
            }
          ],
          "properties": {
            "fresh": {
              "type": "boolean"
            },
            "human": {
              "type": "boolean"
            },
            "kind": {
              "$ref": "#/definitions/ArtifactKind"
            },
            "result": {
              "$ref": "#/definitions/ReviewDisposition"
            },
            "subject": {
              "$ref": "#/definitions/ArtifactRef"
            },
            "subject_kind": {
              "$ref": "#/definitions/ArtifactKind"
            }
          }
        }
      ]
    },
    "SubjectRef": {
      "description": "Subject of evidence, written `<kind>:<id>`.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "Verifier": {
      "description": "A verifier class; the named classes are listed in `examples`, and any other name is treated as an external tool.",
      "examples": [
        "compiler",
        "test-runner",
        "contract-runner",
