          "type": "object",
          "required": [
            "env.exclusive"
          ],
          "properties": {
            "env.exclusive": {
              "$ref": "#/definitions/RawPlugins"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "`{env.output_style: {equals: …}}`",
          "type": "object",
          "required": [
            "env.output_style"
          ],
          "properties": {
            "env.output_style": {
              "$ref": "#/definitions/RawEquals"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "`{env.skill_available: {skill: …}}`, also spelled `{skill.available: {skill: …}}`.",
          "type": "object",
          "required": [
