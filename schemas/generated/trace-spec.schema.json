{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RawTraceSpec",
  "description": "A specification as it is written, before anything has checked what it claims.",
  "type": "object",
  "required": [
    "format",
    "id"
  ],
  "properties": {
    "expectations": {
      "description": "The expectations it declares.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/RawExpectation"
      }
    },
    "format": {
      "description": "The shape the document says it is written in.",
      "type": "string"
    },
    "id": {
      "description": "What the specification is about, such as `planning-plugin/eval`.",
      "type": "string"
    },
    "title": {
      "description": "A human sentence for a report's heading.",
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "RawAgent": {
      "description": "The parameters of `env.agent_available`.",
      "type": "object",
      "required": [
        "agent"
      ],
      "properties": {
        "agent": {
          "description": "The agent's name, as the harness lists it.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RawAggregate": {
      "description": "`total` or `each`, as written.",
      "oneOf": [
        {
          "description": "The default: the sum across every selected call.",
          "type": "string",
          "enum": [
            "total"
          ]
        },
        {
          "description": "Every selected call on its own.",
          "type": "string",
          "enum": [
            "each"
          ]
        }
      ]
    },
    "RawAllowed": {
      "description": "The parameters of `rate_limit.status`.",
      "type": "object",
      "required": [
        "allowed"
      ],
      "properties": {
        "allowed": {
          "description": "The acceptable statuses.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "RawApiErrorStatus": {
      "description": "What the terminal record's `api_error_status` must say: `absent`, or `{equals: \"429\"}`.",
      "oneOf": [
        {
          "description": "`absent` — there must be no API error status at all.",
          "type": "string",
          "enum": [
            "absent"
          ]
        },
        {
          "description": "`{equals: \"429\"}` — there must be one, and it must be this.",
          "type": "object",
          "required": [
            "equals"
          ],
          "properties": {
            "equals": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RawCostTotal": {
      "description": "The parameters of `cost.total`.\n\nThe two keys carry their unit — `at_most_usd`, not `at_most` — because that is how the design writes them, and because a number of dollars beside a number of tokens on the next line should not be spelled identically.",
      "type": "object",
      "properties": {
        "at_least_usd": {
          "description": "The lowest acceptable cost, in US dollars.",
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "at_most_usd": {
          "description": "The highest acceptable cost, in US dollars.",
          "default": null,
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "model": {
          "description": "The model to scope to, where the specification names one.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "RawCount": {
      "description": "The parameters of the eight kinds that bound one whole number and nothing else.",
      "type": "object",
      "required": [
        "count"
      ],
      "properties": {
        "count": {
          "description": "How many are acceptable.",
          "allOf": [
            {
              "$ref": "#/definitions/RawCountBound"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "RawCountBound": {
      "description": "A bound over a whole number as written: `{at_least: 1}`, `{at_most: 3}`, `{exactly: 0}`, or a floor and a ceiling together.\n\nNever a bare number. `count: 1` cannot be read as \"at least once\" by one author and \"exactly once\" by the next, so there is no shorthand to read it as either.",
      "type": "object",
      "properties": {
        "at_least": {
          "description": "The lowest acceptable value.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "at_most": {
          "description": "The highest acceptable value.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "exactly": {
          "description": "The only acceptable value; validation refuses it beside either of the other two.",
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "RawEquals": {
      "description": "The parameters of the six kinds that compare one recorded string.",
      "type": "object",
      "required": [
        "equals"
      ],
      "properties": {
        "equals": {
          "description": "The value expected.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RawEqualsBool": {
      "description": "The parameters of the two kinds that compare one recorded boolean.",
      "type": "object",
      "required": [
        "equals"
      ],
      "properties": {
        "equals": {
          "description": "What it must be.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "RawExpectation": {
      "description": "One expectation as written.",
      "type": "object",
      "required": [
        "expect",
        "id"
      ],
      "properties": {
        "expect": {
          "description": "What it claims.",
          "allOf": [
            {
              "$ref": "#/definitions/RawExpectationKind"
            }
          ]
        },
        "id": {
          "description": "The id a verdict is reported under.",
          "type": "string"
        },
        "on_unknown": {
          "description": "What an undecidable verdict means here. `unknown` when the document omits it.",
          "allOf": [
            {
              "$ref": "#/definitions/RawOnUnknown"
            }
          ]
        },
        "severity": {
          "description": "Whether a gap moves the exit code. `gate` when the document omits it.",
          "allOf": [
            {
              "$ref": "#/definitions/RawSeverity"
            }
          ]
        },
        "statement": {
          "description": "The author's own sentence, carried into the report unchanged.",
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "RawExpectationKind": {
      "description": "An expectation kind as written, externally tagged so the parameter names are checked.\n\nThe variant names are the design's dotted kind names verbatim, and [`ExpectationKind::NAMES`] is the same vocabulary on the validated side. A test at the bottom of this file builds a document for every published name and refuses to let the two lists drift.",
