        }
      },
      {
        "from": "workloads/kube-system/deployment/coredns",
        "site": "volumes[custom-config-volume]",
        "target": {
          "kind": "config_map",
          "name": "coredns-custom",
          "optional": true
        }
      },
      {
        "from": "workloads/shop/deployment/flaky-agent",
        "site": "containers[agent].env[AGENT_TOKEN]",
        "target": {
          "kind": "secret",
          "name": "agent-credentials",
          "optional": false
        }
      }
    ]
  }
}
